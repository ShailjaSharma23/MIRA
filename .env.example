# ========================================================
# MIRA Environment Configuration
# Copy this file to .env.local and fill in your credentials
# ========================================================

# 1. Hugging Face Inference API Token
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=

# 2. Google Gemini API Key (Optional / Multimodal Fallback)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. Live Web Grounding & Search (Tavily AI Search)
# Get 1,000 free monthly queries from: https://tavily.com
TAVILY_API_KEY=

# 4. Google OAuth 2.0 Credentials (Authentication)
# Create OAuth Client ID at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_SECRET=generate_a_random_32_character_secret_here
NEXTAUTH_URL=http://localhost:3000

# 5. Database Connection (PostgreSQL - Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/mira?sslmode=require"
